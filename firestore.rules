rules_version = '2';
// กฎความปลอดภัยของฐานข้อมูล PNM07
// วิธีใช้: คัดลอกทั้งไฟล์ › Firebase console › Firestore Database › Rules › วาง › Publish
//
// - ต้องเป็นสมาชิก (members/{uid}) จึงอ่านข้อมูลได้
// - admin = ผู้ดูแลระบบ, officer = เจ้าหน้าที่ (บันทึกได้), commander = ผู้บังคับบัญชา (ดูอย่างเดียว)
// - ภาพหลักฐาน การส่งมอบ และประวัติการแก้ไข เพิ่มได้อย่างเดียว แก้ไข/ลบไม่ได้
// - เคสที่ล็อกแล้วแก้ไขได้เฉพาะ admin; ไม่มีใครลบเคสหรือตัวอย่างได้
service cloud.firestore {
  match /databases/{database}/documents {
    function memberDoc() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function isMember() { return request.auth != null && exists(memberDoc()); }
    function myRole() { return get(memberDoc()).data.role; }
    function isAdmin() { return isMember() && myRole() == 'admin'; }
    function canWrite() { return isMember() && myRole() in ['admin', 'officer']; }
    function canRead() { return isMember() && myRole() in ['admin', 'officer', 'commander']; }
    function ownerUid() { return get(/databases/$(database)/documents/meta/owner).data.uid; }
    function myEmail() { return request.auth.token.email.lower(); }
    function inviteDoc() { return /databases/$(database)/documents/invites/$(myEmail()); }
    function stamped() { return request.resource.data.updatedBy == request.auth.uid; }
    function notLocked() { return resource.data.get('locked', false) != true; }
    function validDate(f) { return request.resource.data[f] is string && request.resource.data[f].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // ผู้ก่อตั้ง (ผู้ดูแลระบบคนแรก) สร้างได้ครั้งเดียว
    match /meta/owner {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }
    match /meta/settings {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    match /members/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || canRead());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && (
                      // ผู้ก่อตั้ง: สร้างพร้อม meta/owner ในชุดเดียวกัน
                      (request.resource.data.role == 'admin'
                        && getAfter(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid)
                      // ผู้ได้รับเชิญ: ต้องยืนยันอีเมลแล้ว และสิทธิ์ตรงกับคำเชิญ
                      || (request.auth.token.email_verified == true
                        && exists(inviteDoc())
                        && request.resource.data.role == get(inviteDoc()).data.role)
                    );
      allow update: if isAdmin() && request.auth.uid != uid && uid != ownerUid()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'roleAt', 'roleBy'])
                    && request.resource.data.role in ['admin', 'officer', 'commander', 'disabled'];
      allow delete: if false;
    }

    match /invites/{email} {
      allow read: if request.auth != null && (isAdmin() || myEmail() == email);
      allow create, update: if isAdmin() && email == email.lower()
                    && request.resource.data.role in ['admin', 'officer', 'commander'];
      allow delete: if isAdmin();
    }

    match /cases/{id} {
      allow read: if canRead();
      allow create: if canWrite() && stamped() && validDate('date');
      allow update: if canWrite() && stamped() && validDate('date') && (notLocked() || isAdmin());
      allow delete: if false;
    }

    match /samples/{id} {
      allow read: if canRead();
      allow create: if canWrite() && stamped() && validDate('caseDate');
      allow update: if canWrite() && stamped() && validDate('caseDate') && (notLocked() || isAdmin());
      allow delete: if false;
    }

    match /photos/{id} {
      allow read: if canRead();
      allow create: if canWrite() && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.sha256 is string && request.resource.data.sha256.size() == 64;
      allow update, delete: if false;
    }

    match /custody/{id} {
      allow read: if canRead();
      allow create: if canWrite() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    match /audit/{id} {
      allow read: if canRead();
      allow create: if canWrite() && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
